-- =========================================================
-- ESP: MURDERER = ROSSO / SHERIFF = BLU / ALTRI = BIANCO
-- =========================================================

local function GetPlayerRole(player)
    if not player then
        return "Innocent"
    end

    -- Prima prova l'attributo Role
    local role = player:GetAttribute("Role")
    if typeof(role) == "string" then
        role = role:lower()

        if role:find("murder") then
            return "Murderer"
        elseif role:find("sheriff") then
            return "Sheriff"
        end
    end

    -- Rilevamento tramite strumenti posseduti
    local character = player.Character

    if character then
        if character:FindFirstChild("Knife") then
            return "Murderer"
        end

        if character:FindFirstChild("Gun") then
            return "Sheriff"
        end
    end

    -- Controlla anche il Backpack
    local backpack = player:FindFirstChildOfClass("Backpack")

    if backpack then
        if backpack:FindFirstChild("Knife") then
            return "Murderer"
        end

        if backpack:FindFirstChild("Gun") then
            return "Sheriff"
        end
    end

    return "Innocent"
end

local function UpdateESP(player)
    if player == LocalPlayer or not player.Character then
        return
    end

    local character = player.Character

    local hl = character:FindFirstChild("XenoESP")

    if not hl then
        hl = Instance.new("Highlight")
        hl.Name = "XenoESP"
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = character
    end

    hl.Enabled = Settings.EspEnabled

    local role = GetPlayerRole(player)

    if role == "Murderer" then
        -- 🔴 Murderer
        hl.FillColor = Color3.fromRGB(255, 0, 0)
        hl.OutlineColor = Color3.fromRGB(255, 80, 80)
        hl.FillTransparency = 0.35
        hl.OutlineTransparency = 0

    elseif role == "Sheriff" then
        -- 🔵 Sheriff
        hl.FillColor = Color3.fromRGB(0, 100, 255)
        hl.OutlineColor = Color3.fromRGB(80, 170, 255)
        hl.FillTransparency = 0.35
        hl.OutlineTransparency = 0

    else
        -- ⚪ Innocent
        hl.FillColor = Color3.fromRGB(255, 255, 255)
        hl.OutlineColor = Color3.fromRGB(200, 200, 200)
        hl.FillTransparency = 0.75
        hl.OutlineTransparency = 0.25
    end
end

RunService.RenderStepped:Connect(function()
    if not Settings.EspEnabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local esp = player.Character:FindFirstChild("XenoESP")
                if esp then
                    esp.Enabled = false
                end
            end
        end
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        UpdateESP(player)
    end
end)
