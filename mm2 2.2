-- LOOP PRINCIPALI
RunService.Heartbeat:Connect(function()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = Settings.WalkSpeed
    end

    if Settings.KillAura then
        -- Verifica se siamo l'assassino tramite l'oggetto Knife nel character
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Knife") then
            if not TargetRemote then ScanForRemotes() end
            local myChar = LocalPlayer.Character
            if myChar and myChar:FindFirstChild("HumanoidRootPart") then
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        if (myChar.HumanoidRootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude <= Settings.AuraRange then
                            if TargetRemote then TargetRemote:FireServer(p) end
                        end
                    end
                end
            end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hl = p.Character:FindFirstChild("Xeno_ESP") or Instance.new("Highlight", p.Character)
            hl.Name = "Xeno_ESP"
            hl.Enabled = Settings.EspEnabled
            -- Colore rosso per Murderer, bianco per gli altri (se l'attributo esiste)
            hl.FillColor = (p:GetAttribute("Role") == "Murderer") and Color3.fromRGB(255,0,0) or Color3.fromRGB(255,255,255)
        end
    end
end)

local function AddTab(name)
    local TabBtn = Instance.new("TextButton")
