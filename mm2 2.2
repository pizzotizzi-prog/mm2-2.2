-- // SETTINGS & LOGIC
local Settings = {
    KillAura = false,
    EspEnabled = false,
    WalkSpeed = 16,
    AuraRange = 20
}

local TargetRemote = nil
local function ScanForRemotes()
    for _, v in pairs(RepStorage:GetDescendants()) do
        if v:IsA("RemoteEvent") and (v.Name:lower():find("knife") or v.Name:lower():find("attack") or v.Name:lower():find("stab")) then
            TargetRemote = v
            break
        end
    end
end

-- // IMPROVED BUTTON CREATOR (With Animations)
local function CreateToggle(text, default, callback)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 0, 45)
    Btn.BackgroundColor3 = Theme.Button
    Btn.Text = text .. " : " .. (default and "ON" or "OFF")
    Btn.TextColor3 = Theme.Text
    Btn.Font = Enum.Font.GothamMedium
    Btn.TextSize = 14
    Btn.Parent = ContentFrame
    
    local bCorner = Instance.new("UICorner", Btn)
    bCorner.CornerRadius = UDim.new(0, 8)
    
    local bStroke = Instance.new("UIStroke", Btn)
    bStroke.Thickness = 1
    bStroke.Color = Color3.fromRGB(50, 50, 60)

    local state = default
    
    -- Hover Effect
    Btn.MouseEnter:Connect(function()
        TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.ButtonHover}):Play()
    end)
    Btn.MouseLeave:Connect(function()
        TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3 = state and Theme.AccentDark or Theme.Button}):Play()
    end)

    Btn.MouseButton1Click:Connect(function()
        state = not state
        Btn.Text = text .. " : " .. (state and "ON" or "OFF")
        
        -- Animatione di click (piccolo shrink)
        Btn:TweenSize(UDim2.new(0.95, 0, 0, 42), "Out", "Quad", 0.1, true)
        task.wait(0.1)
        Btn:TweenSize(UDim2.new(1, 0, 0, 45), "Out", "Quad", 0.1, true)

        Btn.BackgroundColor3 = state and Theme.AccentDark or Theme.Button
        bStroke.Color = state and Theme.Accent or Color3.fromRGB(50, 50, 60)
        callback(state)
    end)
end

-- // ADDING ELEMENTS
CreateToggle("Kill Aura", false, function(val) 
    Settings.KillAura = val 
    if val then ScanForRemotes() end
end)

CreateToggle("ESP Wallhack", false, function(val) 
