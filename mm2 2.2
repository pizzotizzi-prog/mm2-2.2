-- =========================================================

CreateToggle("ESP Wallhack", false, function(value)

    Settings.EspEnabled = value

    if not value then

        for _, player in ipairs(Players:GetPlayers()) do

            if player.Character then

                local esp = player.Character:FindFirstChild("XenoESP")

                if esp then
                    esp.Enabled = false
                end

            end

        end

    end
end)

