-- LOGICA E VARIABILI
local Settings = {
    KillAura = false,
    EspEnabled = false,
    WalkSpeed = 16,
    AuraRange = 20
}

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")
local RepStorage = game:GetService("ReplicatedStorage")
local TargetRemote = nil

local function ScanForRemotes()
    -- MM2 cambia spesso i nomi dei remotes, cerchiamo per pattern
    for _, v in pairs(RepStorage:GetDescendants()) do
        if v:IsA("RemoteEvent") and (v.Name:lower():find("knife") or v.Name:lower():find("attack") or v.Name:lower():find("stab")) then
            TargetRemote = v
            break
        end
    end
end

local function CreateToggle(name, default, callback)
    local ToggleBtn = Instance.new("TextButton")
    ToggleBtn.Name = name
    ToggleBtn.Parent = ContentFrame
    ToggleBtn.Size = UDim2.new(1, 0, 0, 40)
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
    ToggleBtn.Text = name .. ": " .. (default and "ON" or "OFF")
    ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    ToggleBtn.Font = Enum.Font.Gotham
    ToggleBtn.TextSize = 14
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = ToggleBtn

    local state = default
    ToggleBtn.MouseButton1Click:Connect(function()
        state = not state
        ToggleBtn.Text = name .. ": " .. (state and "ON" or "OFF")
        ToggleBtn.BackgroundColor3 = state and Color3.fromRGB(0, 120, 215) or Color3.fromRGB(45, 45, 60)
        callback(state)
    end)
    return ToggleBtn
end

