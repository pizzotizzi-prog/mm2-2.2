-- =========================================================
-- TOGGLE FUNCTION
-- =========================================================

local function CreateToggle(text, default, callback)

    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 0, 40)
    Btn.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    Btn.Text = text .. ": " .. (default and "ON" or "OFF")
    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Btn.Font = Enum.Font.Gotham
    Btn.TextSize = 14
    Btn.Parent = ContentFrame
    Btn.BorderSizePixel = 0

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 6)
    Corner.Parent = Btn

    local state = default

    Btn.MouseButton1Click:Connect(function()

        state = not state

        Btn.Text = text .. ": " .. (state and "ON" or "OFF")

        if state then
            Btn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
        else
            Btn.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
        end

        callback(state)
    end)

    return Btn
end

-- =========================================================
-- ESP ROLE DETECTION
-- =========================================================

local function GetPlayerRole(player)

    if not player then
        return "Innocent"
    end

    -- Controllo attributo Role
    local role = player:GetAttribute("Role")

    if typeof(role) == "string" then

        local lowerRole = role:lower()

        if lowerRole:find("murder") then
            return "Murderer"
        end

        if lowerRole:find("sheriff") then
            return "Sheriff"
        end
    end

    local character = player.Character

    -- Controllo Character
    if character then

        if character:FindFirstChild("Knife") then
            return "Murderer"
        end

        if character:FindFirstChild("Gun") then
            return "Sheriff"
        end
    end

    -- Controllo Backpack
    local backpack = player:FindFirstChildOfClass("Backpack")

    if backpack then

        if backpack:FindFirstChild("Knife") then
            return "Murderer"
        end

        if backpack:FindFirstChild("Gun") then
            return "Sheriff"
        end
    end

    return "Innocent"
end

-- =========================================================
-- ESP CREATION
-- =========================================================

local function UpdateESP(player)

    if player == LocalPlayer then
        return
    end

    local character = player.Character

    if not character then
        return
    end

    local hl = character:FindFirstChild("XenoESP")

    if not hl then

        hl = Instance.new("Highlight")
        hl.Name = "XenoESP"
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = character

    end

    hl.Enabled = Settings.EspEnabled

    if not Settings.EspEnabled then
        return
    end

    local role = GetPlayerRole(player)

    -- =====================================================
    -- MURDERER = ROSSO
    -- =====================================================

    if role == "Murderer" then

        hl.FillColor = Color3.fromRGB(255, 0, 0)
        hl.OutlineColor = Color3.fromRGB(255, 80, 80)
        hl.FillTransparency = 0.35
        hl.OutlineTransparency = 0

    -- =====================================================
    -- SHERIFF = BLU
    -- =====================================================

    elseif role == "Sheriff" then

        hl.FillColor = Color3.fromRGB(0, 100, 255)
        hl.OutlineColor = Color3.fromRGB(80, 170, 255)
        hl.FillTransparency = 0.35
        hl.OutlineTransparency = 0

    -- =====================================================
    -- INNOCENT = BIANCO
    -- =====================================================

    else

        hl.FillColor = Color3.fromRGB(255, 255, 255)
        hl.OutlineColor = Color3.fromRGB(200, 200, 200)
        hl.FillTransparency = 0.75
        hl.OutlineTransparency = 0.25

    end
end

