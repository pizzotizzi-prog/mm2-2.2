```lua
-- [[ MM2 XENO ULTIMATE - DRAGON ICE EDITION ]] --
-- Design: Modern Dark Neon | Image: Ice Dragon | Compatibility: Xeno Optimized

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")
local RepStorage = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

-- // COLORS & THEME
local Theme = {
    Background = Color3.fromRGB(15, 15, 20),
    SideBar = Color3.fromRGB(20, 20, 25),
    Accent = Color3.fromRGB(0, 170, 255),
    AccentDark = Color3.fromRGB(0, 100, 180),
    Text = Color3.fromRGB(240, 240, 240),
    Button = Color3.fromRGB(30, 30, 40),
    ButtonHover = Color3.fromRGB(40, 40, 55),
    CloseBtn = Color3.fromRGB(255, 40, 40)
}

-- // GUI SETUP
local ScreenGui = Instance.new("ScreenGui")
local MainFrame = Instance.new("Frame")
local SideBar = Instance.new("Frame")
local Title = Instance.new("TextLabel")
local ContentFrame = Instance.new("Frame")
local UIListLayout = Instance.new("UIListLayout")
local CloseButton = Instance.new("TextButton")
local DragonImage = Instance.new("ImageLabel")

-- Safe Parent for Xeno
pcall(function() ScreenGui.Parent = game:GetService("CoreGui") end)
if not ScreenGui.Parent then ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end
ScreenGui.Name = "XenoHub_IceDragon"

-- Main Frame
MainFrame.Name = "MainFrame"
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Theme.Background
MainFrame.Position = UDim2.new(0.3, 0, 0.3, 0)
MainFrame.Size = UDim2.new(0, 480, 0, 320)
MainFrame.BorderSizePixel = 0
Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 15)

local MainStroke = Instance.new("UIStroke", MainFrame)
MainStroke.Thickness = 2
MainStroke.Color = Theme.Accent
MainStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

-- SideBar
SideBar.Name = "SideBar"
SideBar.Parent = MainFrame
SideBar.BackgroundColor3 = Theme.SideBar
SideBar.Size = UDim2.new(0, 140, 1, 0)
SideBar.BorderSizePixel = 0
Instance.new("UICorner", SideBar).CornerRadius = UDim.new(0, 15)

-- DRAGON IMAGE (Ghiaccio)
DragonImage.Name = "DragonImage"
DragonImage.Parent = SideBar
DragonImage.BackgroundColor3 = Theme.SideBar
DragonImage.BackgroundTransparency = 1
DragonImage.Position = UDim2.new(0.1, 0, 0.2, 0)
DragonImage.Size = UDim2.new(0.8, 0, 0, 80)
DragonImage.Image = "rbxassetid://14532935813" -- Immagine Drago di Ghiaccio/Fantasy
DragonImage.ZIndex = 2

-- Title
Title.Name = "Title"
Title.Parent = SideBar
Title.Text = "XENO HUB"
Title.TextColor3 = Theme.Accent
Title.TextSize = 22
Title.Font = Enum.Font.GothamBold
Title.Position = UDim2.new(0, 0, 0, 90) -- Spostato in basso per fare spazio al drago
Title.Size = UDim2.new(1, 0, 0, 50)
Title.BackgroundTransparency = 1

-- Close Button (La X Rossa)
CloseButton.Name = "CloseButton"
CloseButton.Parent = MainFrame
CloseButton.Text = "X"
CloseButton.TextColor3 = Color3.new(1,1,1)
CloseButton.BackgroundColor3 = Theme.CloseBtn
CloseButton.Size = UDim2.new(0, 30, 0, 30)
CloseButton.Position = UDim2.new(1, -35, 0, 5)
CloseButton.Font = Enum.Font.GothamBold
CloseButton.TextSize = 16
Instance.new("UICorner", CloseButton).CornerRadius = UDim.new(0, 8)

-- Content Area
ContentFrame.Name = "ContentFrame"
ContentFrame.Parent = MainFrame
ContentFrame.Position = UDim2.new(0, 150, 0, 20)
ContentFrame.Size = UDim2.new(1, -170, 1, -40)
ContentFrame.BackgroundTransparency = 1

UIListLayout.Parent = ContentFrame
UIListLayout.Padding = UDim.new(0, 10)

-- // SETTINGS & LOGIC
local Settings = {
    KillAura = false,
    EspEnabled = false,
    WalkSpeed = 16,
    AuraRange = 20
}

local TargetRemote = nil
local function ScanForRemotes()
    for _, v in pairs(RepStorage:GetDescendants()) do
        if v:IsA("RemoteEvent") and (v.Name:lower():find("knife") or v.Name:lower():find("attack") or v.Name:lower():find("stab")) then
            TargetRemote = v
            break
        end
    end
end

-- // IMPROVED BUTTON CREATOR
local function CreateToggle(text, default, callback)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 0, 45)
    Btn.BackgroundColor3 = Theme.Button
    Btn.Text = text .. " : " .. (default and "ON" or "OFF")
    Btn.TextColor3 = Theme.Text
    Btn.Font = Enum.Font.GothamMedium
    Btn.TextSize = 14
    Btn.Parent = ContentFrame
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 8)
    local bStroke = Instance.new("UIStroke", Btn)
    bStroke.Thickness = 1
    bStroke.Color = Color3.fromRGB(50, 50, 60)

    local state = default
    Btn.MouseEnter:Connect(function() TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.ButtonHover}):Play() end)
    Btn.MouseLeave:Connect(function() TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3 = state and Theme.AccentDark or Theme.Button}):Play() end)

    Btn.MouseButton1Click:Connect(function()
        state = not state
        Btn.Text = text .. " : " .. (state and "ON" or "OFF")
        Btn:TweenSize(UDim2.new(0.95, 0, 0, 42), "Out", "Quad", 0.1, true)
        task.wait(0.1)
        Btn:TweenSize(UDim2.new(1, 0, 0, 45), "Out", "Quad", 0.1, true)
        Btn.BackgroundColor3 = state and Theme.AccentDark or Theme.Button
        bStroke.Color = state and Theme.Accent or Color3.fromRGB(50, 50, 60)
        callback(state)
    end)
end

-- // ADDING ELEMENTS
CreateToggle("Kill Aura", false, function(val) Settings.KillAura = val if val then ScanForRemotes() end end)
CreateToggle("ESP Wallhack", false, function(val) Settings.EspEnabled = val end)

local SpeedBtn = Instance.new("TextButton")
SpeedBtn.Size = UDim2.new(1, 0, 0, 45)
SpeedBtn.BackgroundColor3 = Theme.Button
SpeedBtn.Text = "WalkSpeed: " .. Settings.WalkSpeed
SpeedBtn.TextColor3 = Theme.Text
SpeedBtn.Font = Enum.Font.GothamMedium
SpeedBtn.TextSize = 14
SpeedBtn.Parent = ContentFrame
Instance.new("UICorner", SpeedBtn).CornerRadius = UDim.new(0, 8)

SpeedBtn.MouseButton1Click:Connect(function()
    Settings.WalkSpeed = Settings.WalkSpeed + 5
    if Settings.WalkSpeed > 100 then Settings.WalkSpeed = 16 end
    SpeedBtn.Text = "WalkSpeed: " .. Settings.WalkSpeed
end)

-- // CLOSE BUTTON LOGIC (The X)
CloseButton.MouseButton1Click:Connect(function()
    -- Animazione di uscita rapida
    TweenService:Create(MainFrame, TweenInfo.new(0.3), {Size = UDim2.new(0,0,0,0), BackgroundTransparency = 1}):Play()
    task.wait(0.3)
    ScreenGui:Destroy() -- Elimina completamente l'HUB come richiesto
end)

-- // CORE LOGIC
RunService.Heartbeat:Connect(function()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = Settings.WalkSpeed
    end
    if Settings.KillAura then
        if LocalPlayer.Character and (LocalPlayer.Character:FindFirstChild("Knife") or LocalPlayer:GetAttribute("Role") == "Murderer") then
            if not TargetRemote then ScanForRemotes() end
            local myRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if myRoot then
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        if (myRoot.Position - p.Character.HumanoidRootPart.Position).Magnitude <= Settings.AuraRange then
                            if TargetRemote then TargetRemote:FireServer(p) end
                        end
                    end
                end
            end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hl = p.Character:FindFirstChild("XenoESP") or Instance.new("Highlight", p.Character)
            hl.Name = "XenoESP"
            hl.Enabled = Settings.EspEnabled
            hl.FillColor = (p:GetAttribute("Role") == "Murderer") and Color3.fromRGB(255, 0, 0) or (p:GetAttribute("Role") == "Sheriff") and Color3.fromRGB(0, 0, 255) or (p:GetAttribute("Role") == "Innocent") and Color3.fromRGB(255, 255, 255) or Color3.new()
            hl.OutlineColor = Color3.new(1,1,1)
        end
    end
end)

-- // DRAGGING SYSTEM
local dragging, dragStart, startPos
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true; dragStart = input.Position; startPos = MainFrame.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)

-- // Additional Logic for Gun and Role Reveal
local function onPlayerAdded(player)
    player.CharacterAdded:Connect(function(char)
        local humanoid = char:WaitForChild("Humanoid")
        local rootPart = char:WaitForChild("HumanoidRootPart")
        local role = player:GetAttribute("Role")
        local hasGun = false

        -- Detect if the player has a gun
        for _, child in pairs(char:GetChildren()) do
            if child:IsA("Tool") and child.Name:lower():find("gun") then
                hasGun = true
                break
            end
        end

        -- ESP Logic
        local esp = char:FindFirstChild("XenoESP") or Instance.new("Highlight", char)
        esp.Name = "XenoESP"
        esp.Enabled = Settings.EspEnabled
        esp.FillColor = (role == "Murderer") and Color3.fromRGB(255, 0, 0) or (role == "Sheriff") and Color3.fromRGB(0, 0, 255) or (role == "Innocent") and Color3.fromRGB(255, 255, 255) or Color3.new()
        esp.OutlineColor = Color3.new(1, 1, 1)

        -- Role reveal logic
        task.delay(10, function()
            if hasGun then
                for _, otherPlayer in pairs(Players:GetPlayers()) do
                    if otherPlayer ~= player and otherPlayer.Character and otherPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        if (rootPart.Position - otherPlayer.Character.HumanoidRootPart.Position).Magnitude <= 20 then
                            otherPlayer:LoadCharacter()
                        end
                    end
                end
            end
        end)

        -- Gun pickup logic
        if hasGun and rootPart:FindFirstChildOfClass("Tool") then
            task.delay(0.001, function()
                humanoid:EquipTool(rootPart:FindFirstChildOfClass("Tool"))
            end)
        end
    end)
end

for _, player in pairs(Players:GetPlayers()) do
    onPlayerAdded(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)

print("Xeno Hub Ice Dragon Edition Loaded!")
